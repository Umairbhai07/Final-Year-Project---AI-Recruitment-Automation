APP_ENV=development
DATABASE_URL=sqlite:///./recruiter.db
JWT_SECRET=change-me
JWT_ACCESS_HOURS=24
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:5173

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3
# true = simulated AI (no key needed). Also on automatically when LLM_API_KEY is empty.
AI_MOCK=false
AI_TIMEOUT_SECONDS=30

STORAGE_BACKEND=local          # local | supabase
LOCAL_STORAGE_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=recruiter-files

EMAIL_BACKEND=console          # console | smtp (Gmail) | resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=                 # Gmail App password
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173
